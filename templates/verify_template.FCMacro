"""Standalone checks over generated/ (run under freecadcmd):
   freecadcmd verify_template.FCMacro   (.FCMacro so freecadcmd executes it)
Add per-project checks here when they are too slow for every generator run."""
import glob, os, sys
import FreeCAD
import Part
GEN = os.environ.get("OUT_DIR", os.path.join(os.path.dirname(os.path.abspath(__file__)), "generated"))
bad = 0
for step in sorted(glob.glob(os.path.join(GEN, "*.step"))):
    s = Part.read(step)
    ok = bool(s.Solids) and s.isValid()
    print("%-40s solids=%d valid=%s vol=%.0f" % (os.path.basename(step), len(s.Solids), s.isValid(), s.Volume))
    bad += not ok
print("verify: %d bad" % bad)
sys.stdout.flush()          # freecadcmd exits without flushing on sys.exit
sys.exit(1 if bad else 0)
